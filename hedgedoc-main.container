[Unit]
Description=Hedgedoc main container
Requires=hedgedoc-db.service
After=hedgedoc-db.service

[Container]
Image=quay.io/hedgedoc/hedgedoc:1.12.0-alpine
ContainerName=hedgedoc-main
Volume=/var/mnt/bigdrive/hedgedoc/uploads:/hedgedoc/public/uploads:Z
Network=hedgedoc-net.network
Environment=CMD_DB_URL=postgres://hedgedoc:<password>@database:54432/hedgedoc
Environment=CMD_DOMAIN=localhost
Environment=CMD_URL_ADDPORT=true
# Look at docs for further config
Port=3000:3000 #??

[Service]
Restart=always

[Install]
WantedBy=default.target
